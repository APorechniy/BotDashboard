{
    "extends": "@app/tsconfig/base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@app/contracts": [
                "../../packages/contracts/src/index.ts"
            ]
        },
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "noEmit": true
    },
    "include": [
        "src/**/*",
        "vite.config.ts"
    ]
}